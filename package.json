{
  "name": "atlas-hybrid-rag",
  "version": "1.0.0",
  "description": "Hybrid RAG on MongoDB Atlas: $vectorSearch + $search fused with Reciprocal Rank Fusion",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "query": "tsx scripts/query.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "rag",
    "mongodb",
    "atlas",
    "vector-search",
    "hybrid-search",
    "reciprocal-rank-fusion",
    "embeddings",
    "openai",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongodb": "^6.8.0",
    "openai": "^4.56.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
